{
  "repo_root": "@PROJECT_SOURCE_DIR@",
  "build_dir": "@PROJECT_BINARY_DIR@",
  "scratch_dir": "@PROJECT_BINARY_DIR@/test",
  "cmake": "@CMAKE_COMMAND@",
  "ctest": "@CMAKE_CTEST_COMMAND@",
  "generator": "@CMAKE_GENERATOR@",
  "make_program": "@CMAKE_MAKE_PROGRAM@",
  "build_type": "@CMAKE_BUILD_TYPE@",
  "cxx_compiler": "@CMAKE_CXX_COMPILER@",
  "doctest_include_dir": "@SCAV_DOCTEST_INCLUDE_DIR@",
  "python": "@Python3_EXECUTABLE@",
  "cxx_flags": "@CMAKE_CXX_FLAGS@",
  "exe_linker_flags": "@CMAKE_EXE_LINKER_FLAGS@",
  "sanitizer": "@SCAV_SANITIZER@",
  "coverage": "@SCAV_COVERAGE@",
  "testing_define": "@SCAV_TESTING@",
  "version": "@PROJECT_VERSION@"
}
