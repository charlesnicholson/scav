# Everything scav generates and nothing else, so `rm -rf out` is a factory reset
# and no build step writes to $HOME.
/out/

# CTest's scratch, which it drops in whatever directory it was invoked from.
# Nothing should invoke it from here -- the build tree is the place -- but a
# stray `ctest` in the source root should not be committable.
/Testing/

# Rewritten by envy on every invocation, and names a per-machine cache path.
/.luarc.json

# `envy cache --local|--shared` writes one of these to record one machine's
# preference. Carried into new worktrees by .worktreeinclude, never committed.
/.envy-cache-local
/.envy-cache-shared

# envy deploys a launcher per product, and these two exist only under SCAV_LINT.
# Tracking them would make an ordinary `envy sync` delete them.
/bin/clang-format
/bin/clang-format.bat
/bin/clang-tidy
/bin/clang-tidy.bat

# The tests and tools import each other, so bytecode lands next to the sources.
__pycache__/
*.py[cod]

.DS_Store
*.swp
.cache/
