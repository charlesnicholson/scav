# Everything scav generates and nothing else, so `rm -rf out` is a factory reset
# and no build step writes to $HOME.
/out/

# A coverage build writes its raw profile to $LLVM_PROFILE_FILE, which the test
# harness points into the build tree (cmake/ScavTesting.cmake). Running an
# instrumented binary by hand instead drops `default.profraw` in whatever the
# cwd happened to be, so the pattern is unanchored rather than rooted.
*.profraw
*.profdata

# CTest's scratch, which it drops in whatever directory it was invoked from.
# Nothing should invoke it from here -- the build tree is the place -- but a
# stray `ctest` in the source root should not be committable.
/Testing/

# `envy cache --local|--shared` writes one of these to record one machine's
# preference. Conductor workspaces get shared via .conductor/settings.toml.
/.envy-cache-local
/.envy-cache-shared

# envy deploys a launcher per product, and these exist only under SCAV_LINT or
# SCAV_BASELINE. Tracking them would make an ordinary `envy sync` delete them.
/bin/clang-format
/bin/clang-format.bat
/bin/clang-tidy
/bin/clang-tidy.bat
/bin/elk_bundle
/bin/elk_bundle.bat
/bin/node
/bin/node.bat
/bin/plantuml
/bin/plantuml.bat

# The tests and tools import each other, so bytecode lands next to the sources.
__pycache__/
*.py[cod]

.DS_Store
*.swp
.cache/
