// The worked example from PRD 15, and the root of the corpus network: three
// documents, two of them included, one of those included twice. `scav dump`
// prints the whole network as one containment tree -- resolution links, it
// does not flatten (PRD 9) -- and the golden under test_data/golden/dump/
// pins the output byte for byte.
chart vac "robot vacuum" {
  include "dock.scav" as dock,
  // led.scav is also included by dock.scav, so it is one Document parsed once
  // and two instantiations with disjoint entity rows (PRD 9). The two sets
  // differ only by InstId, and they lay out separately, which is correct.
  include "./led.scav" as lamp,
  state Off "powered down",
  state Booting,
  state PreConfig choice,
  trans * -> Off,
  trans Off -> Booting "POWER_ON",
  state On {
    @doc = "Enter: publishes EVT_POWERED_ON",
    @nav { follow_walls = "false", uses_lidar },
    submachine main {
      state Idle { @nav:retry = "false" },
      state Ready,
      trans * -> Idle,
      trans internal Ready -> Ready "BUMP_RETRY",
      // The cross-document endpoint: three segments, the first of which is an
      // include alias two levels up.
      trans Ready -> dock/On/Seated "battery low",
    },
    submachine aux "sweeps while main drives" { state Idle, trans * -> Idle },
  },
}
