// One servo axis. Instantiated four times: three from mill.scav under the same
// parent submachine, and once more from toolchanger.scav.
chart axis "servo axis" {
  include "estop.scav" as stop,
  state Parked,
  state Homing,
  state Ready,
  state Reached choice,
  // Concurrent: travel runs the profile while monitor watches following error.
  state Moving "under motion" {
    @doc = "both submachines run while the axis travels",
    submachine travel {
      state Accelerating,
      state Cruising,
      state Decelerating,
      trans * -> Accelerating,
      trans Accelerating -> Cruising "at speed",
      trans Cruising -> Decelerating "approaching target",
    },
    submachine monitor "following error watchdog" {
      state Nominal,
      state Excessive,
      trans * -> Nominal,
      trans internal Nominal -> Nominal "sample",
      trans Nominal -> Excessive "error over limit",
    },
  },
  trans * -> Parked,
  trans Parked -> Homing "home",
  trans Homing -> Ready "index found",
  trans Ready -> Moving "move",
  trans Moving -> Reached "target reached",
  trans Reached -> Ready "ok",
  trans Reached -> Parked "out of range",
  // Down into this document's own include.
  trans Moving -> stop/Tripped "limit switch",
}
