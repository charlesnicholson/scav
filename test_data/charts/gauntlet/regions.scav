// Concurrent regions, and a transition between two of them each way. Each crosses
// the divider between the regions once, square to it, at one port on the divider,
// and no route passes through a box or doubles back.
chart regions "two regions and a crossing" {
  state Running {
    submachine motor {
      state Spinning,
      state Stopped,
      trans * -> Stopped,
      trans Stopped -> Spinning "start",
    },
    submachine light { state Dark, state Lit, trans * -> Dark, trans Dark -> Lit "on" },
  },
  state Halted,

  trans * -> Running,
  trans Running:motor/Spinning -> Running:light/Lit "spun up",
  trans Running:light/Lit -> Running:motor/Stopped "lamp fault",
  trans Running -> Halted "stop",
}
