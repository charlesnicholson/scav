// Concurrent regions, and a transition between two of them. The two regions are
// siblings under a state, so the nearest enclosing submachine is one level
// further out than that state, and there the state was an ordinary obstacle
// walling the route out of the space between its own regions: it went the long
// way round, through whatever else that frame held and back along the line it
// arrived on. The channel is routed inside the state now (11.10g), and the
// counts gauntlet_tests.cpp pins for it are zero bar one route at `compact`.
chart regions "two regions and a crossing" {
  state Running {
    submachine motor {
      state Spinning,
      state Stopped,
      trans * -> Stopped,
      trans Stopped -> Spinning "start",
    },
    submachine light { state Dark, state Lit, trans * -> Dark, trans Dark -> Lit "on" },
  },
  state Halted,

  trans * -> Running,
  trans Running:motor/Spinning -> Running:light/Lit "spun up",
  trans Running:light/Lit -> Running:motor/Stopped "lamp fault",
  trans Running -> Halted "stop",
}
