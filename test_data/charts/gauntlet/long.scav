// A labelled edge across three rank boundaries, `ota`'s `timeout`, beside a
// wider label on the first of them. The long edge runs through that boundary
// too, so its label has room beside it there, and no other boundary it
// crosses has to grow for it.
chart long "a long edge's label in a gap already wide enough" {
  state Offered,
  state Fetching,
  state Checking,
  state Done,

  trans * -> Offered,
  trans Offered -> Fetching "every chunk has been received",
  trans Fetching -> Checking,
  trans Checking -> Done,
  trans Offered -> Done "timeout",
}
