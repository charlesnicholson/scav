// A composite whose frame runs across, entered from a state above one of its
// children. A port sat only on the border its frame's ranks start or end at, so
// the route came down beside the composite and in through its far side; on the
// border facing the source, it is one straight line down to the child.
chart above "a composite entered from above" {
  state Source,
  state Box {
    state Near,
    state Middle,
    state Far,
    trans * -> Near,
    trans Near -> Middle,
    trans Middle -> Far,
  },

  trans * -> Source,
  trans Source -> Box/Middle "drop",
}
