// A run long enough to fold, where moving one state a rank along squares the
// drawing up by a few units of aspect and pays for it with one arrow across the
// whole width. Nothing else in the cost vector sees that arrow: it is straight,
// so it has no bends and no excess over its own direct distance.
chart stretch "six in a row" {
  state A,
  state B,
  state C,
  state D,
  state E,
  state F,

  trans * -> A,
  trans A -> B,
  trans B -> C,
  trans C -> D,
  trans D -> E,
  trans E -> F,
}
