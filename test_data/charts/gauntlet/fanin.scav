// Several transitions into one state. Each arrives as its own arrow at its own
// point on the target, sharing no line with another.
chart fanin "many sources, one target" {
  state A,
  state B,
  state C,
  state D,
  state Fault,

  trans * -> A,
  trans A -> B,
  trans B -> C,
  trans C -> D,
  trans A -> Fault "a failed",
  trans B -> Fault "b failed",
  trans C -> Fault "c failed",
  trans D -> Fault "d failed",
}
