// Fourteen transitions into one state from a chain of fifteen. Each arrival takes
// its own seat on the target, and no two arrivals cross or share a line.
chart fanwide "fourteen arrivals from one chain" {
  state S0,
  state S1,
  state S2,
  state S3,
  state S4,
  state S5,
  state S6,
  state S7,
  state S8,
  state S9,
  state S10,
  state S11,
  state S12,
  state S13,
  state S14,
  state Fault,

  trans * -> S0,
  trans S0 -> S1,
  trans S1 -> S2,
  trans S2 -> S3,
  trans S3 -> S4,
  trans S4 -> S5,
  trans S5 -> S6,
  trans S6 -> S7,
  trans S7 -> S8,
  trans S8 -> S9,
  trans S9 -> S10,
  trans S10 -> S11,
  trans S11 -> S12,
  trans S12 -> S13,
  trans S13 -> S14,
  trans S1 -> Fault,
  trans S2 -> Fault,
  trans S3 -> Fault,
  trans S4 -> Fault,
  trans S5 -> Fault,
  trans S6 -> Fault,
  trans S7 -> Fault,
  trans S8 -> Fault,
  trans S9 -> Fault,
  trans S10 -> Fault,
  trans S11 -> Fault,
  trans S12 -> Fault,
  trans S13 -> Fault,
  trans S14 -> Fault,
}
