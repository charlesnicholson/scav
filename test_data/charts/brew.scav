// Written to touch every element the model holds: nesting, concurrency, every
// pseudostate, and all three attribute spellings. Its dump is a golden.
chart brew "espresso machine" {
  @doc = "counter-top espresso robot",
  @power { mains, watts = "1200" },

  state Off,
  state Standby "warm and idle",
  state SelfCheck choice,

  trans * -> Off,
  trans Off -> SelfCheck "power switch",
  trans SelfCheck -> Standby "ok",
  trans SelfCheck -> Off "fault",

  state Brewing {
    @doc = "both submachines run while a shot pulls",

    submachine water "boiler and pump" {
      state Heating { @tune = "pid" },
      state Pumping,
      trans * -> Heating,
      trans Heating -> Pumping "at temperature",
      trans internal Pumping -> Pumping "pressure adjust",
    },
    submachine grinder {
      state Grinding,
      state Dosing,
      trans * -> Grinding,
      trans Grinding -> Dosing "ground",
    },
  },

  trans Standby -> Brewing "brew button",
  trans Brewing -> Standby "shot done",
  trans Standby -> * "descale overdue",
}
