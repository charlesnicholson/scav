// The leaf of the mill network, included by mill.scav, axis.scav and
// toolchanger.scav. Six instantiations across three including documents, all
// from this one parsed copy.
chart estop "emergency stop" {
  @doc = "one latching mushroom head",

  state Clear,
  state Tripped,
  state Latched,

  trans * -> Clear,
  trans Clear -> Tripped "pressed",
  trans Tripped -> Latched "held",
  trans Latched -> Clear "twist release",
}
